rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check: reads the caller's role field from Firestore
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─── 1. Users Collection & Subcollections ──────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read profiles (for rosters, creator lookups, referral matching)
      allow read: if isAuthenticated();
      // Only owner can create their own profile
      allow create: if isOwner(userId);
      // Owner can update their own profile, BUT cannot self-escalate role to admin.
      // Admins can update any user (e.g. to grant/revoke roles).
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          !(request.resource.data.get('role', 'student') == 'admin' &&
            resource.data.get('role', 'student') != 'admin'));
      allow delete: if isAdmin() || isOwner(userId);

      // Subcollections (Summaries, Quizzes, Flashcard Sets, Notes, Study Packs, Folders, etc.)
      match /{collection}/{contentId} {
        allow read, write: if isOwner(userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /content_folders/{contentFolderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── 2. Creator Partnership Program Collections ────────────────────────────

    // Creator Applications
    // - Anyone can submit (create) or read (for email uniqueness checks)
    // - Only admins can approve/reject (update status) or delete
    match /creator_applications/{applicationId} {
      allow read: if true; // Open read for uniqueness check on form
      allow create: if true; // Open submission
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.get('uid', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Creator Profiles
    // - Publicly readable (for referral links & public badges)
    // - Creators can only update their own profile
    // - Admins can update/delete any profile (e.g. suspend, verify)
    match /creator_profiles/{creatorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == creatorId;
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == creatorId);
      allow delete: if isAdmin();
    }

    // Creator Referral Clicks (Logged by guests on link click)
    match /creator_referral_clicks/{clickId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Creator Resources & Media Kits (admin-managed content)
    match /creator_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Creator Referrals
    match /creator_referrals/{referralId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Creator Payouts — only admins can mark payouts as paid/completed
    match /creator_payouts/{payoutId} {
      allow read: if isAuthenticated() &&
        (resource.data.get('creatorId', '') == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Creator Achievements (admin-awarded)
    match /creator_achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Trigger Email Queue (Firebase Mail Extension)
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // ─── 3. Public Decks & Teacher Materials ───────────────────────────────────
    match /public_decks/{deckId} {
      allow read: if true; // Publicly accessible via share code or URL slug
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );

      // Views subcollection for unique view tracking
      match /views/{viewerId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ─── 4. Student Quiz & Exam Attempts ───────────────────────────────────────
    match /attempts/{attemptId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── 5. System Config & Payments ───────────────────────────────────────────
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{txRef} {
      allow read: if isAuthenticated() &&
        (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
