rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── 1. Users Collection & Subcollections ──────────────────────────────────
    match /users/{userId} {
      // Allow authenticated users to read profiles (e.g. for student rosters, creator lookups, referral matching)
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollections (Summaries, Quizzes, Flashcard Sets, Notes, Study Packs, Folders, etc.)
      match /{collection}/{contentId} {
        allow read, write: if isOwner(userId);
      }

      match /folders/{folderId} {
        allow read, write: if isOwner(userId);
      }

      match /content_folders/{contentFolderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── 2. Creator Partnership Program Collections ────────────────────────────
    
    // Creator Applications
    match /creator_applications/{applicationId} {
      // Allow read & create so prospective creators can verify email uniqueness & submit applications
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Creator Profiles (Publicly readable for referral links & badges)
    match /creator_profiles/{creatorId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Creator Referral Clicks (Logged by guests on link click)
    match /creator_referral_clicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Creator Resources & Media Kits
    match /creator_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Creator Referrals
    match /creator_referrals/{referralId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Creator Payouts
    match /creator_payouts/{payoutId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Creator Achievements
    match /creator_achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Trigger Email Queue (Firebase Mail Extension)
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }

    // ─── 3. Public Decks & Teacher Materials ───────────────────────────────────
    match /public_decks/{deckId} {
      allow read: if true; // Publicly accessible via share code or URL slug
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid
      );

      // Views subcollection for unique view tracking
      match /views/{viewerId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ─── 4. Student Quiz & Exam Attempts ───────────────────────────────────────
    match /attempts/{attemptId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid != null
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      );
    }

    // ─── 5. System Config & Payments ───────────────────────────────────────────
    match /system/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /payments/{txRef} {
      allow read, write: if isAuthenticated();
    }
  }
}

